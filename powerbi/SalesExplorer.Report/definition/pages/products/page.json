{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "products",
  "displayName": "03  Follow the signal",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#0B1420'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "productReview",
      "target": "productHistory",
      "type": "DataFilter"
    },
    {
      "source": "productReview",
      "target": "sourceLines",
      "type": "DataFilter"
    }
  ]
}
