// Create each definition separately with New measure. This is reference text, not a DAX query.
// Display monetary measures as #,##0.00 without a currency symbol; counts as #,##0; rates as 0.0%.
// Native reconciliation checks: see NATIVE_QA.md and evidence/powerbi/native-checks.dax.

Sales = COALESCE(DIVIDE(SUM(Sales[SalesUnits]), 10000), 0)

Orders = COALESCE(DISTINCTCOUNT(Sales[OrderID]), 0)

AOV = DIVIDE([Sales], [Orders])

// Use DeliveryCoverage[Month] in a single-select slicer. This table is disconnected.
Report Month =
    SELECTEDVALUE(DeliveryCoverage[Month], MAXX(ALL(DeliveryCoverage), DeliveryCoverage[Month]))

// The global source cutoff must not move when a viewer selects a category or region.
As Of Date =
    VAR StartDate = [Report Month]
    VAR LastDay = EOMONTH(StartDate, 0)
    VAR Observed = MAXX(
        FILTER(ALL(Sales), Sales[OrderDate] >= StartDate && Sales[OrderDate] <= LastDay),
        Sales[OrderDate])
    RETURN COALESCE(Observed, LastDay)

Cutoff Date =
    VAR Anchor = [As Of Date]
    VAR PriorLastDay = DAY(EOMONTH(DATE(YEAR(Anchor) - 1, MONTH(Anchor), 1), 0))
    RETURN DATE(YEAR(Anchor), MONTH(Anchor), MIN(DAY(Anchor), PriorLastDay))

Prior Delivery Available =
    VAR PriorMonth = EDATE([Report Month], -12)
    RETURN COUNTROWS(FILTER(ALL(DeliveryCoverage),
        DeliveryCoverage[Month] = PriorMonth && DeliveryCoverage[Coverage] = "Imported")) > 0

Matched Sales =
    VAR StartDate = [Report Month]
    VAR EndDate = [Cutoff Date]
    RETURN CALCULATE([Sales], FILTER(ALL(Dates), Dates[Date] >= StartDate && Dates[Date] <= EndDate))

Matched Orders =
    VAR StartDate = [Report Month]
    VAR EndDate = [Cutoff Date]
    RETURN CALCULATE([Orders], FILTER(ALL(Dates), Dates[Date] >= StartDate && Dates[Date] <= EndDate))

Prior Matched Sales =
    VAR StartDate = EDATE([Report Month], -12)
    VAR EndDate = EDATE([Cutoff Date], -12)
    RETURN IF([Prior Delivery Available],
        CALCULATE([Sales], FILTER(ALL(Dates), Dates[Date] >= StartDate && Dates[Date] <= EndDate)), BLANK())

Prior Matched Orders =
    VAR StartDate = EDATE([Report Month], -12)
    VAR EndDate = EDATE([Cutoff Date], -12)
    RETURN IF([Prior Delivery Available],
        CALCULATE([Orders], FILTER(ALL(Dates), Dates[Date] >= StartDate && Dates[Date] <= EndDate)), BLANK())

Matched AOV = DIVIDE([Matched Sales], [Matched Orders])

Prior Matched AOV = DIVIDE([Prior Matched Sales], [Prior Matched Orders])

Sales Change = IF([Prior Delivery Available], [Matched Sales] - [Prior Matched Sales], BLANK())

Sales Change % = DIVIDE([Sales Change], [Prior Matched Sales])

Orders Change % = IF([Prior Delivery Available], DIVIDE([Matched Orders] - [Prior Matched Orders], [Prior Matched Orders]), BLANK())

AOV Change % = IF(NOT ISBLANK([Matched AOV]) && NOT ISBLANK([Prior Matched AOV]),
    DIVIDE([Matched AOV] - [Prior Matched AOV], [Prior Matched AOV]), BLANK())

Period Caption =
    FORMAT([Report Month], "yyyy-MM-dd") & " to " & FORMAT([Cutoff Date], "yyyy-MM-dd") &
    " versus " & FORMAT(EDATE([Report Month], -12), "yyyy-MM-dd") & " to " &
    FORMAT(EDATE([Cutoff Date], -12), "yyyy-MM-dd") &
    IF([Prior Delivery Available], " | Historical sample; source units", " | Prior-year delivery missing")
